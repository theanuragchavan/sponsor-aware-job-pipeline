# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env*

# ---------------------------------------------------------------------------
# PERSONAL DATA — this repo is public and this is a real job search.
# The code is the project; the job hunt is not. None of the following is
# reconstructable from what is committed, which is the point.
# ---------------------------------------------------------------------------
jobs_tracker_beautified.xlsx
jobs_tracker.csv
*.LOCKED-*.xlsx
data/jobs_tracker_backup_*.xlsx
pipeline/decisions.json
pipeline/sponsor_review.md
pipeline/shortlists/
pipeline/profile.md
data/sponsor_aliases.json
data/sponsor_rejections.json
data/decision_log.jsonl

# Machine-specific: hardcoded interpreter path and project root.
# run_tracker.bat.example is committed in its place.
run_tracker.bat

# Personal working context, absolute paths, and status notes
CLAUDE.md
STATUS_*.md
adzuna_tracker_brief.md
compass_artifact_*.md
.claude/
job-search-kit/

# ---------------------------------------------------------------------------
# Regenerable state and caches. The register is 10.9 MB and gov.uk republishes
# it under a new dated filename most days, so committing it would be both large
# and immediately stale — sponsor_check.py fetches the current one.
# ---------------------------------------------------------------------------
data/sponsors_register.csv
data/sponsors_register_meta.json
data/call_counter.json
data/ats_call_counter.json
data/reed_call_counter.json
data/ats_probe_cache.json
data/ats_closed.json
pipeline/liveness_cache.json
logs/

# ---------------------------------------------------------------------------
# Python / OS
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
*.stackdump

# ---------------------------------------------------------------------------
# Web app. Build output and dependencies only — web/demo/data/ IS committed,
# because the deployed demo must not run a generator on a cold start.
# ---------------------------------------------------------------------------
web/ui/node_modules/
web/ui/dist/
.vercel
data/contacts.json
# Real names, employers and email addresses of people who connected with him.
# The most personal file in the repo and the one nobody in it consented to.
data/connections.json
# His own application history, including roles applied to outside the pipeline.
data/manual_applications.json

# Outreach drafts: real names, and messages that are his to send.
drafts/

# Personal answers to application-form questions: visa status, salary floor,
# disclosure fields. Pushed to this PUBLIC repo by accident on 2026-08-21 --
# data_contract classified it user-layer correctly, but the contract governs
# the packager, not git. Two mechanisms, and only one of them was updated.
data/screening.yml

# Per-job handoff bundles: a CV, a cover letter, a JD and the gate verdict.
# Outputs, not source, and personal either way.
packages/
runs/
data/indeed_raw.txt
data/indeed_staging.csv
data/indeed_raw_t*.txt
run_indeed.bat
